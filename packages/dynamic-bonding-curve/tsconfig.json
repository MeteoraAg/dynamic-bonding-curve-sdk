{
    "compilerOptions": {
        "outDir": "dist",
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "target": "es2020",
        "module": "esnext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts", "tests/**/*.ts"],
    "exclude": ["node_modules", "dist", "scripts"]
}
